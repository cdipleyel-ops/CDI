    );

    game.appendChild(element);
}

/* =========================================================
   TICK
   ========================================================= */

function tick() {

    if (!running || paused) return;

    score += .5;

    const newLevel =
        1 + Math.floor(score / 150);

    if (newLevel > level) {

        level = newLevel;

        sfx("level");

        showCombo(
            "⬆️ NIVEAU " + level
        );

        createParticles(
            50,
            25,
            ["⭐","✨","🔥"]
        );
    }

    if (comboTimer > 0) {

        comboTimer--;

        if (comboTimer <= 0) {
            combo = 1;
        }
    }

    checkObjects();

    updateHUD();
    updatePowers();
}

/* =========================================================
   COLLISIONS
   ========================================================= */

function checkObjects() {

    const player =
        document.getElementById("player");

    const playerRect =
        player.getBoundingClientRect();

    /*
       HITBOX VOLONTAIREMENT PETITE :
       on retire une grosse marge autour du pain.
    */

    const p = {
        left: playerRect.left + playerRect.width * .28,
        right: playerRect.right - playerRect.width * .28,
        top: playerRect.top + playerRect.height * .24,
        bottom: playerRect.bottom - playerRect.height * .16
    };

    document
        .querySelectorAll(".obstacle,.coin,.powerup")
        .forEach(object => {

            if (!document.body.contains(object)) return;

            const rect =
                object.getBoundingClientRect();

            const r = {
                left: rect.left + rect.width * .30,
                right: rect.right - rect.width * .30,
                top: rect.top + rect.height * .25,
                bottom: rect.bottom - rect.height * .20
            };

            const hit =
                p.left < r.right &&
                p.right > r.left &&
                p.top < r.bottom &&
                p.bottom > r.top;

            if (!hit) {

                /*
                  AIMANT :
                  attire les pièces proches.
                */

                if (
                    object.classList.contains("coin") &&
                    Date.now() < magnetUntil
                ) {

                    const dx =
                        Math.abs(
                            playerRect.left - rect.left
                        );

                    const dy =
                        Math.abs(
                            playerRect.top - rect.top
                        );

                    if (dx < 220 && dy < 180) {

                        collectCoin(object);

                    }
                }

                return;
            }

            if (object.classList.contains("coin")) {

                collectCoin(object);

            } else if (
                object.classList.contains("powerup")
            ) {

                collectPowerup(object);

            } else {

                hitObstacle(object);
            }
        });
}

/* =========================================================
   COINS
   ========================================================= */

function collectCoin(coin) {

    if (!coin.isConnected) return;

    coin.remove();

    const amount =
        Date.now() < doubleCoinsUntil
            ? 2
            : 1;

    runCoins += amount;

    comboTimer = 100;

    combo = Math.min(
        10,
        combo + 1
    );

    save.totalCoins += amount;
    save.missions.coins += amount;

    sfx("coin");

    createParticles(
        50,
        45,
        ["🪙","✨","💰"]
    );

    if (combo >= 3) {
        showCombo("🔥 COMBO x" + combo);
    }

    saveGame();
}

/* =========================================================
   POWERUPS
   ========================================================= */

function collectPowerup(element) {

    if (!element.isConnected) return;

    const power =
        element.dataset.power;

    element.remove();

    save.powerups++;
    save.missions.powerups++;

    switch (power) {

        case "shield":

            shield = true;

            showCombo("🛡️ BOUCLIER !");

            break;

        case "magnet":

            magnetUntil =
                Date.now() + 8000;

            showCombo("🧲 AIMANT !");

            break;

        case "double":

            doubleCoinsUntil =
                Date.now() + 8000;

            showCombo("✖️2️⃣ PIÈCES x2 !");

            break;

        case "slow":

            slowUntil =
                Date.now() + 7000;

            showCombo("🐌 RALENTI !");

            break;
    }

    sfx("power");

    createParticles(
        50,
        40,
        ["✨","⭐","⚡"]
    );

    saveGame();
    updatePowers();
}

function updatePowers() {

    const container =
        document.getElementById("activePowers");

    container.innerHTML = "";

    if (shield) {

        container.innerHTML +=
            `<span class="powerBadge">🛡️</span>`;
    }

    if (Date.now() < magnetUntil) {

        container.innerHTML +=
            `<span class="powerBadge">🧲</span>`;
    }

    if (Date.now() < doubleCoinsUntil) {

        container.innerHTML +=
            `<span class="powerBadge">✖️2️⃣</span>`;
    }

    if (Date.now() < slowUntil) {

        container.innerHTML +=
            `<span class="powerBadge">🐌</span>`;
    }
}

/* =========================================================
   COLLISION OBSTACLE
   ========================================================= */

function hitObstacle(obstacle) {

    if (!obstacle.isConnected) return;

    if (shield) {

        shield = false;

        obstacle.remove();

        sfx("power");

        showCombo("🛡️ BLOQUÉ !");

        createParticles(
            50,
            40,
            ["🛡️","✨","💥"]
        );

        updatePowers();

        return;
    }

    obstacle.remove();

    sfx("hit");

    const game =
        document.getElementById("game");

    game.classList.remove("hit");

    /*
       Force le navigateur à recalculer
       l'animation pour pouvoir la rejouer.
    */
    void game.offsetWidth;

    game.classList.add("hit");

    createParticles(
        12,
        45,
        ["💥","🍞","😵","🔥"]
    );

    gameOver();
}

/* =========================================================
   GAME OVER
   ========================================================= */

function gameOver() {

    if (!running) return;

    running = false;

    stopGameTimers();

    save.coins += runCoins;

    save.distance += Math.floor(score);

    if (score > save.best) {
        save.best = Math.floor(score);
    }

    save.missions.jumps =
        Math.max(
            save.missions.jumps,
            0
        );

    saveGame();

    document.getElementById(
        "gameOverText"
    ).innerHTML = `
        Score : <strong>${Math.floor(score)}</strong><br>
        🪙 Pièces gagnées : <strong>${runCoins}</strong><br>
        🏆 Record : <strong>${save.best}</strong><br><br>
        ${score > save.best - 1
            ? "🔥 Nouveau record !"
            : "Le pain a besoin d'un boulanger."
        }
    `;

    document
        .getElementById("gameOverOverlay")
        .classList.remove("hidden");

    updateMenu();
}

/* =========================================================
   JUMP
   ========================================================= */

let jumpCooldown = false;

function jump() {

    if (!running || paused || jumpCooldown) return;

    jumpCooldown = true;

    const player =
        document.getElementById("player");

    player.classList.remove("jumping");

    void player.offsetWidth;

    player.classList.add("jumping");

    save.jumps++;
    save.missions.jumps++;

    sfx("jump");

    createParticles(
        13,
        71,
        ["💨","🍞","✨"]
    );

    setTimeout(() => {
        jumpCooldown = false;
    }, 180);
}

