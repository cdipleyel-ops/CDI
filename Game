let running = false;
let paused = false;

let score = 0;
let runCoins = 0;
let combo = 1;
let comboTimer = 0;
let level = 1;

let spawnTimer = null;
let gameLoop = null;

let shield = false;
let magnetUntil = 0;
let doubleCoinsUntil = 0;
let slowUntil = 0;

let obstacleCount = 0;

/* =========================================================
   GAME START
   ========================================================= */

function startGame() {

    initAudio();
    sfx("start");

    stopGameTimers();

    showScreen("gameScreen");

    const game = document.getElementById("game");

    game.querySelectorAll(
        ".obstacle,.coin,.powerup,.particle"
    ).forEach(e => e.remove());

    document
        .getElementById("pauseOverlay")
        .classList.add("hidden");

    document
        .getElementById("gameOverOverlay")
        .classList.add("hidden");

    score = 0;
    runCoins = 0;
    combo = 1;
    comboTimer = 0;
    level = 1;
    shield = false;
    magnetUntil = 0;
    doubleCoinsUntil = 0;
    slowUntil = 0;
    obstacleCount = 0;

    running = true;
    paused = false;

    save.games++;
    save.missions.games++;

    saveGame();

    updateHUD();
    updatePowers();

    document.getElementById("player").textContent =
        getSkin(save.equipped).emoji;

    gameLoop = setInterval(tick, 50);

    scheduleSpawn();

    if (save.music) {
        startMusic();
    }
}

function stopGameTimers() {

    if (spawnTimer) {
        clearTimeout(spawnTimer);
        spawnTimer = null;
    }

    if (gameLoop) {
        clearInterval(gameLoop);
        gameLoop = null;
    }
}

function quitGame() {

    stopGameTimers();

    running = false;
    paused = false;

    showScreen("menuScreen");
    updateMenu();
}

/* =========================================================
   SPAWN
   ========================================================= */

function scheduleSpawn() {

    if (!running || paused) return;

    const difficulty =
        Math.min(score / 500, 1.8);

    const delay =
        Math.max(
            550,
            1350 - difficulty * 400 + Math.random() * 500
        );

    spawnTimer = setTimeout(() => {

        spawnObstacle();

        if (Math.random() < .45) {
            spawnCoinLine();
        }

        if (
            score > 80 &&
            Math.random() < .10
        ) {
            spawnPowerup();
        }

        scheduleSpawn();

    }, delay);
}

function spawnObstacle() {

    if (!running || paused) return;

    const game = document.getElementById("game");

    const obstacle = document.createElement("div");

    obstacle.className = "obstacle emoji";

    const choices = [
        "🥖",
        "🥐",
        "🍳",
        "🧈",
        "🌶️",
        "🧱",
        "🧀",
        "🍩"
    ];

    obstacle.textContent =
        choices[Math.floor(Math.random() * choices.length)];

    obstacle.style.left = "105%";

    const speed =
        Math.max(
            2.0,
            4.2 - level * .12
        );

    obstacle.style.setProperty(
        "--speed",
        speed + "s"
    );

    game.appendChild(obstacle);

    obstacleCount++;
}

function spawnCoinLine() {

    const game = document.getElementById("game");

    const amount =
        2 + Math.floor(Math.random() * 4);

    const yPositions = [
        "31%",
        "38%",
        "45%"
    ];

    for (let i = 0; i < amount; i++) {

        const coin = document.createElement("div");

        coin.className = "coin emoji";

        coin.textContent = "🪙";

        coin.style.left =
            (105 + i * 6) + "%";

        coin.style.setProperty(
            "--coinY",
            yPositions[
                Math.floor(Math.random() * yPositions.length)
            ]
        );

        coin.style.setProperty(
            "--speed",
            Math.max(2.2, 4.5 - level * .1) + "s"
        );

        game.appendChild(coin);
    }
}

function spawnPowerup() {

    const game = document.getElementById("game");

    const powers = [
        {
            id: "shield",
            emoji: "🛡️"
        },
        {
            id: "magnet",
            emoji: "🧲"
        },
        {
            id: "double",
            emoji: "✖️2️⃣"
        },
        {
