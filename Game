        </div>

        <div class="statBox">
            <div class="statIcon emoji">📏</div>
            <div class="statValue">${save.distance}</div>
            <div>Distance</div>
        </div>
    `;

    renderMissions();
}

function renderMissions() {

    const container =
        document.getElementById("missions");

    const missions = [
        {
            icon: "🪙",
            title: "Collectionneur",
            text: "Récolte 100 pièces",
            value: save.missions.coins,
            goal: 100
        },
        {
            icon: "⬆️",
            title: "Sauteur fou",
            text: "Effectue 100 sauts",
            value: save.missions.jumps,
            goal: 100
        },
        {
            icon: "🎮",
            title: "Boulanger professionnel",
            text: "Lance 10 parties",
            value: save.missions.games,
            goal: 10
        },
        {
            icon: "⚡",
            title: "Power-Up addict",
            text: "Utilise 20 pouvoirs",
            value: save.missions.powerups,
            goal: 20
        }
    ];

    container.innerHTML = "";

    missions.forEach(mission => {

        const percent =
            Math.min(
                100,
                mission.value / mission.goal * 100
            );

        const div =
            document.createElement("div");

        div.className = "mission";

        div.innerHTML = `
            <strong class="emoji">
                ${mission.icon}
                ${mission.title}
            </strong>

            <br>

            <small>
                ${mission.text}
                — ${Math.min(mission.value, mission.goal)}
                / ${mission.goal}
            </small>

            <div class="progress">
                <div style="width:${percent}%"></div>
            </div>
        `;

        container.appendChild(div);
    });
}

/* =========================================================
   SETTINGS
   ========================================================= */

function updateSettings() {

    document
        .getElementById("sfxSwitch")
        .classList.toggle(
            "active",
            save.sfx
        );

    document
        .getElementById("musicSwitch")
        .classList.toggle(
            "active",
            save.music
        );
}

/* =========================================================
   RESET
   ========================================================= */

function resetSave() {

    const confirmed =
        confirm(
            "Supprimer toute la progression de Pain Runner ?"
        );

    if (!confirmed) return;

    localStorage.removeItem(SAVE_KEY);

    stopMusic();

    save = loadSave();

    updateMenu();
    updateSettings();
    renderShop();
    renderStats();

    sfx("equip");
}

/* =========================================================
   INITIALISATION
   ========================================================= */

updateMenu();
updateSettings();

/*
   On ne démarre PAS l'audio automatiquement.
   Les navigateurs bloquent généralement l'audio
   avant une interaction de l'utilisateur.
*/

console.log(
    "🍞 Pain Runner V2 chargé avec succès !"
);
</script>

