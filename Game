        </div>

        <div class="currencyBar">
            <div class="currency">
                <span class="emoji">🪙</span>
                <strong id="menuCoins">0</strong>
                Pièces
            </div>

            <div class="currency">
                <span class="emoji">🏆</span>
                <strong id="menuBest">0</strong>
                Meilleur score
            </div>
        </div>

        <div class="footer">
            Unicode test :
            <span class="emoji">🍞 🥖 🥐 🪙 ✨ 🔥 💥 🛡️ 🧲 ⚡</span>
            <br><br>
            Aucun serveur. Aucun fichier audio externe. Tout fonctionne dans ce HTML.
        </div>
    </div>
</section>

<!-- =====================================================
     SHOP
     ===================================================== -->

<section id="shopScreen" class="screen hidden">
    <div class="panel shopPanel">

        <div class="topBar">
            <h2>🛒 Boutique de pains</h2>

            <div>
                <span class="emoji">🪙</span>
                <strong id="shopCoins">0</strong>
            </div>
        </div>

        <div id="shopGrid" class="shopGrid"></div>

        <br>

        <button class="btn secondary" onclick="showScreen('menuScreen')">
            ← Retour
        </button>

    </div>
</section>

<!-- =====================================================
     STATS
     ===================================================== -->

<section id="statsScreen" class="screen hidden">
    <div class="panel statsPanel">

        <div class="topBar">
            <h2>📊 Statistiques</h2>
        </div>

        <div id="statsGrid" class="statsGrid"></div>

        <h2 style="margin-top:30px">🎯 Missions</h2>

        <div id="missions"></div>

        <br>

        <button class="btn secondary" onclick="showScreen('menuScreen')">
            ← Retour
        </button>

    </div>
</section>

<!-- =====================================================
     SETTINGS
     ===================================================== -->

<section id="settingsScreen" class="screen hidden">
    <div class="panel settingsPanel">

        <h2>⚙️ Paramètres</h2>

        <div class="setting">
            <div>
                <strong>🔊 Effets sonores</strong>
                <br>
                <small>Jump, pièces, collisions, boutique...</small>
            </div>
            <button id="sfxSwitch" class="switch active"
                    onclick="toggleSFX()"></button>
        </div>

        <div class="setting">
            <div>
                <strong>🎵 Musique</strong>
                <br>
                <small>Petite musique générée directement par le navigateur</small>
            </div>
            <button id="musicSwitch" class="switch"
                    onclick="toggleMusic()"></button>
        </div>

        <div class="setting">
            <div>
                <strong>🧹 Réinitialiser la sauvegarde</strong>
                <br>
                <small>Supprime les pièces, skins et statistiques.</small>
            </div>

            <button class="btn danger" onclick="resetSave()">
                Reset
            </button>
        </div>

        <br>

        <button class="btn secondary" onclick="showScreen('menuScreen')">
            ← Retour
        </button>

    </div>
</section>

<!-- =====================================================
     GAME
     ===================================================== -->

<section id="gameScreen" class="screen hidden">

    <div class="gameWrap">

        <div class="hud">

            <div class="hudBox">
                <span class="hudLabel">SCORE</span>
                <span id="scoreDisplay" class="hudValue">0</span>
            </div>

            <div class="hudBox">
                <span class="hudLabel">🪙 PIÈCES</span>
                <span id="runCoinsDisplay" class="hudValue">0</span>
            </div>

            <div class="hudBox">
                <span class="hudLabel">NIVEAU</span>
                <span id="levelDisplay" class="hudValue">1</span>
            </div>

            <div class="hudBox">
                <span class="hudLabel">🔥 COMBO</span>
                <span id="comboDisplay" class="hudValue">x1</span>
            </div>

        </div>

        <div id="game">

            <div class="cloud one emoji">☁️</div>
