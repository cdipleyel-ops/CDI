                            🏠 Menu
                        </button>

                    </div>

                </div>
            </div>

        </div>

        <p class="footer">
            🖱️ Clique / 📱 touche l'écran / ⌨️ ESPACE ou ↑ pour sauter
        </p>

    </div>
