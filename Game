function createParticles(x, y, list) {

    const game =
        document.getElementById("game");

    for (let i = 0; i < 7; i++) {

        const p =
            document.createElement("div");

        p.className = "particle emoji";

        p.textContent =
            list[
                Math.floor(
                    Math.random() * list.length
                )
            ];

        p.style.left =
            x + (Math.random() * 8 - 4) + "%";

        p.style.top =
            y + (Math.random() * 8 - 4) + "%";

        p.style.setProperty(
            "--dx",
            (Math.random() * 120 - 60) + "px"
        );

        p.style.setProperty(
            "--dy",
            (Math.random() * -120 - 20) + "px"
        );

        game.appendChild(p);

        setTimeout(
            () => p.remove(),
            750
        );
    }
}

function showCombo(text) {

    const popup =
        document.getElementById("comboPopup");

    popup.textContent = text;

    popup.classList.remove("show");

    void popup.offsetWidth;

    popup.classList.add("show");
}

