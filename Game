<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="description" content="Pain Runner V2 - Le jeu de course avec du pain">
<title>🍞 Pain Runner V2</title>

<style>
/* =========================================================
   PAIN RUNNER V2
   Aucun fichier externe : tout est dans ce HTML.
   ========================================================= */

:root {
    --bg: #100b08;
    --panel: rgba(36, 22, 15, .94);
    --panel2: rgba(55, 32, 20, .95);
    --text: #fff4df;
    --muted: #c8aa88;
    --gold: #ffd166;
    --orange: #ff9f43;
    --red: #ff5c5c;
    --green: #70e000;
    --border: rgba(255, 209, 102, .22);
    --shadow: 0 15px 45px rgba(0,0,0,.45);
}

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html, body {
    margin: 0;
    min-height: 100%;
    background:
        radial-gradient(circle at 50% 0%, #3b2114 0%, #100b08 55%);
    color: var(--text);
    font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        "Segoe UI Emoji",
        "Apple Color Emoji",
        "Noto Color Emoji",
        sans-serif;
}

body {
    overflow-x: hidden;
}

button {
    font: inherit;
}

#app {
    width: 100%;
    min-height: 100vh;
}

/* =========================
   COMMON
   ========================= */

.hidden {
    display: none !important;
}

.screen {
    width: 100%;
    min-height: 100vh;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.panel {
    width: min(1100px, 100%);
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 28px;
    box-shadow: var(--shadow);
    backdrop-filter: blur(12px);
}

.btn {
    border: 0;
    border-radius: 16px;
    padding: 14px 20px;
    color: #2b1608;
    background: linear-gradient(135deg, #ffd166, #ff9f43);
    font-weight: 900;
    cursor: pointer;
    transition: transform .15s, filter .15s;
    box-shadow: 0 8px 20px rgba(255,159,67,.2);
}

.btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
}

.btn:active {
    transform: scale(.96);
}

.btn.secondary {
    color: var(--text);
    background: #3a2418;
    box-shadow: none;
}

.btn.danger {
    color: white;
    background: #9e2f2f;
}

.btn.big {
    font-size: 1.2rem;
    padding: 17px 28px;
}

.emoji {
    font-family:
        "Segoe UI Emoji",
        "Apple Color Emoji",
        "Noto Color Emoji",
        system-ui,
        sans-serif;
    font-variant-emoji: emoji;
}

.title {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 5rem);
    line-height: 1;
    text-align: center;
}

.subtitle {
    color: var(--muted);
    text-align: center;
    margin: 15px auto 30px;
    max-width: 650px;
}

/* =========================
   MENU
   ========================= */

#menuScreen {
    background:
        radial-gradient(circle at 50% 20%, rgba(255,159,67,.16), transparent 35%);
}

.menuPanel {
    padding: clamp(25px, 6vw, 60px);
}

.logo {
    text-align: center;
    font-size: clamp(3rem, 12vw, 7rem);
    animation: floating 2.5s ease-in-out infinite;
}

@keyframes floating {
    0%,100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-12px) rotate(2deg); }
}

.menuButtons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    max-width: 620px;
    margin: auto;
}

.menuButtons .btn {
    min-height: 62px;
}

.currencyBar {
    margin: 25px auto 0;
    max-width: 620px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
}

.currency {
    flex: 1;
    min-width: 130px;
    background: #25170f;
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 12px;
    text-align: center;
}

.currency strong {
    display: block;
    font-size: 1.25rem;
    color: var(--gold);
}

/* =========================
   SHOP
   ========================= */

.shopPanel {
    padding: 25px;
}

.topBar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 20px;
}

.topBar h2 {
    margin: 0;
}

.shopGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 15px;
}

.skinCard {
    background: #24160e;
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 18px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.skinCard.owned {
    border-color: rgba(112,224,0,.45);
}

.skinCard.equipped {
    box-shadow: 0 0 0 2px rgba(255,209,102,.5), 0 12px 30px rgba(0,0,0,.25);
}

.skinEmoji {
    font-size: 4rem;
    margin: 10px 0;
}

.skinName {
    font-weight: 900;
}

.skinPrice {
    color: var(--gold);
    margin: 8px;
}

.skinRarity {
    color: var(--muted);
    font-size: .8rem;
    margin-bottom: 10px;
}

.skinCard button {
    width: 100%;
}

/* =========================
   STATS
   ========================= */

.statsPanel {
    padding: 25px;
}

.statsGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 15px;
}

.statBox {
    background: #24160e;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 20px;
    text-align: center;
}

.statIcon {
    font-size: 2rem;
}

.statValue {
    color: var(--gold);
    font-size: 1.7rem;
    font-weight: 900;
}

/* =========================
   SETTINGS
   ========================= */

.settingsPanel {
    padding: 25px;
}

.setting {
    background: #24160e;
    border-radius: 17px;
    padding: 17px;
    margin: 10px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.switch {
    width: 58px;
    height: 32px;
    border: 0;
    border-radius: 50px;
    background: #5a4030;
    cursor: pointer;
    position: relative;
}

.switch::after {
    content: "";
    position: absolute;
    width: 24px;
    height: 24px;
    top: 4px;
    left: 5px;
    border-radius: 50%;
    background: white;
    transition: transform .2s;
}

.switch.active {
    background: #d88b32;
}

.switch.active::after {
    transform: translateX(24px);
}

/* =========================
   GAME
   ========================= */

#gameScreen {
    padding: 10px;
    align-items: flex-start;
}

.gameWrap {
    width: min(1200px, 100%);
}

.hud {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 8px;
}

.hudBox {
    background: rgba(36,22,15,.95);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 8px;
    text-align: center;
}

.hudLabel {
    display: block;
    color: var(--muted);
    font-size: .7rem;
}

.hudValue {
    font-weight: 900;
    color: var(--gold);
}

#game {
    position: relative;
    height: min(68vh, 620px);
    min-height: 390px;
    overflow: hidden;
    border-radius: 25px;
    border: 2px solid rgba(255,209,102,.22);
    background:
        linear-gradient(
            to bottom,
            #65c5ff 0%,
            #b8e8ff 53%,
            #eec77c 54%,
            #c48a45 100%
        );
    user-select: none;
    touch-action: manipulation;
}

/* Soleil */

#game::before {
    content: "☀️";
    position: absolute;
    top: 30px;
    right: 8%;
    font-size: 5rem;
    opacity: .85;
}

.cloud {
    position: absolute;
    font-size: 3.5rem;
    opacity: .75;
    animation: cloudMove linear infinite;
}

.cloud.one {
    top: 13%;
    left: -10%;
    animation-duration: 24s;
}

.cloud.two {
    top: 28%;
    left: -20%;
    animation-duration: 32s;
    animation-delay: -8s;
}

@keyframes cloudMove {
    from { transform: translateX(-100px); }
    to { transform: translateX(130vw); }
}

/* Sol */

.ground {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 43%;
    background:
        repeating-linear-gradient(
            120deg,
            #c9914a 0 35px,
            #b77c3d 35px 70px
        );
    border-top: 5px solid #7b4b28;
}

/* Joueur */

#player {
    position: absolute;
    left: 10%;
    bottom: 25%;
    width: 76px;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4.2rem;
    z-index: 20;
    filter: drop-shadow(0 7px 4px rgba(0,0,0,.3));
    will-change: transform;
}

#player.jumping {
    animation: playerJump .55s ease-out;
}

@keyframes playerJump {
    0% { transform: translateY(0) rotate(0); }
    40% { transform: translateY(-20px) rotate(-8deg); }
    100% { transform: translateY(0) rotate(0); }
}

/* Objets */

.obstacle,
.coin,
.powerup {
    position: absolute;
    z-index: 15;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
}

.obstacle {
    font-size: 3.1rem;
    width: 65px;
    height: 65px;
    bottom: 25%;
    animation: obstacleMove var(--speed) linear forwards;
    filter: drop-shadow(0 5px 3px rgba(0,0,0,.3));
}

.coin {
    font-size: 2.2rem;
    width: 48px;
    height: 48px;
    bottom: var(--coinY);
    animation: coinMove var(--speed) linear forwards;
}

.powerup {
    font-size: 2.5rem;
    width: 55px;
    height: 55px;
    bottom: var(--powerY);
    animation: powerMove var(--speed) linear forwards;
}

@keyframes obstacleMove {
    from { transform: translateX(0); }
    to { transform: translateX(-130vw); }
}

@keyframes coinMove {
    from { transform: translateX(0) rotate(0); }
    to { transform: translateX(-130vw) rotate(720deg); }
}

@keyframes powerMove {
    from { transform: translateX(0) scale(1); }
    50% { transform: translateX(-60vw) scale(1.15); }
    to { transform: translateX(-130vw) scale(1); }
}

/* Particules */

.particle {
    position: absolute;
    pointer-events: none;
    z-index: 100;
    font-size: 1.4rem;
    animation: particleFly .7s ease-out forwards;
}

@keyframes particleFly {
    from {
        transform: translate(0,0) scale(1);
        opacity: 1;
    }
    to {
        transform:
            translate(
                var(--dx),
                var(--dy)
            )
            scale(.2);
        opacity: 0;
    }
}

/* Combo */

#comboPopup {
    position: absolute;
    left: 50%;
    top: 20%;
    transform: translate(-50%,-50%);
    z-index: 200;
    font-size: 2rem;
    font-weight: 1000;
    color: var(--gold);
    pointer-events: none;
    opacity: 0;
}

#comboPopup.show {
    animation: comboShow .75s ease-out;
}

@keyframes comboShow {
    0% { opacity: 0; transform: translate(-50%,0) scale(.5); }
    25% { opacity: 1; transform: translate(-50%,-20px) scale(1.2); }
    100% { opacity: 0; transform: translate(-50%,-70px) scale(1); }
}

/* Pouvoirs actifs */

#activePowers {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 100;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.powerBadge {
    background: rgba(20,10,5,.8);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 10px;
    padding: 6px 9px;
}

/* Bouton pause */

.pauseButton {
    position: absolute;
    right: 12px;
    top: 12px;
    z-index: 150;
    border: 0;
    border-radius: 12px;
    background: rgba(30,15,8,.8);
    color: white;
    padding: 10px 14px;
    cursor: pointer;
}

/* Overlays */

.overlay {
    position: absolute;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(12,7,4,.72);
    backdrop-filter: blur(5px);
}

.overlayCard {
    width: min(480px, 100%);
    padding: 30px;
    border-radius: 25px;
    background: #24160e;
    border: 1px solid var(--border);
    text-align: center;
}

.overlayCard h2 {
    font-size: 2.5rem;
    margin-top: 0;
}

.overlayButtons {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
}

/* Flash / shake */

#game.hit {
    animation: shake .35s linear;
}

@keyframes shake {
    0%,100% { transform: translateX(0); }
    20% { transform: translateX(-8px); }
    40% { transform: translateX(8px); }
    60% { transform: translateX(-6px); }
    80% { transform: translateX(6px); }
}

#game.shielded {
    box-shadow: inset 0 0 0 5px rgba(80,200,255,.7);
}

/* Missions */

.mission {
    background: #24160e;
    border-radius: 15px;
    padding: 15px;
    margin: 10px 0;
}

.progress {
    height: 10px;
    background: #4a3020;
    border-radius: 20px;
    overflow: hidden;
    margin-top: 10px;
}

.progress > div {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg,#ffd166,#ff9f43);
    transition: width .3s;
}

/* Footer */

.footer {
    text-align: center;
    color: var(--muted);
    margin-top: 25px;
    font-size: .85rem;
}

/* Mobile */

@media (max-width: 650px) {
    .screen {
        padding: 10px;
    }

    .menuButtons {
        grid-template-columns: 1fr;
    }

    .hud {
        grid-template-columns: repeat(2, 1fr);
    }

    #game {
        height: 68vh;
        min-height: 430px;
        border-radius: 18px;
    }

    #player {
        width: 62px;
        height: 62px;
        font-size: 3.5rem;
        left: 8%;
    }

    .obstacle {
        font-size: 2.6rem;
    }

    .title {
        font-size: 2.8rem;
    }

    .shopGrid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .skinEmoji {
        font-size: 3rem;
    }
}
</style>
</head>

<body>

<div id="app">

<!-- =====================================================
     MENU
     ===================================================== -->

<section id="menuScreen" class="screen">
    <div class="panel menuPanel">

        <div class="logo emoji">🍞</div>

        <h1 class="title">
            Pain Runner
        </h1>

        <p class="subtitle">
            Cours, saute, mange des pièces et évite tout ce qui veut
            transformer ton pain en tartine écrasée.
        </p>

        <div class="menuButtons">
            <button class="btn big" onclick="startGame()">
                ▶️ Jouer
            </button>

            <button class="btn secondary big" onclick="showScreen('shopScreen')">
                🛒 Boutique
            </button>

            <button class="btn secondary big" onclick="showScreen('statsScreen')">
