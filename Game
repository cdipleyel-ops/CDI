<script>
"use strict";

/* =========================================================
   SAUVEGARDE
   ========================================================= */

const SAVE_KEY = "pain_runner_v2_save";

const defaultSave = {
    coins: 0,
    best: 0,
    totalCoins: 0,
    games: 0,
    jumps: 0,
    powerups: 0,
    distance: 0,
    skins: ["classic"],
    equipped: "classic",
    sfx: true,
    music: false,
    missions: {
        coins: 0,
        jumps: 0,
        games: 0,
        powerups: 0
    }
};

let save = loadSave();

function loadSave() {
    try {
        const raw = localStorage.getItem(SAVE_KEY);

        if (!raw) {
            return structuredClone(defaultSave);
        }

        const data = JSON.parse(raw);

        return {
            ...structuredClone(defaultSave),
            ...data,
            missions: {
                ...defaultSave.missions,
                ...(data.missions || {})
            }
        };
    } catch (error) {
        console.warn("Sauvegarde invalide :", error);
        return structuredClone(defaultSave);
    }
}

function saveGame() {
    localStorage.setItem(SAVE_KEY, JSON.stringify(save));
}

/* =========================================================
   SKINS
   ========================================================= */

const skins = [
    {
        id: "classic",
        name: "Pain Classique",
        emoji: "🍞",
        price: 0,
        rarity: "Commun"
    },
    {
        id: "baguette",
        name: "Baguette Ninja",
        emoji: "🥖",
        price: 100,
