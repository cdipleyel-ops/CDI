function renderShop() {

    const grid = document.getElementById("shopGrid");

    grid.innerHTML = "";

    skins.forEach(skin => {

        const owned = save.skins.includes(skin.id);
        const equipped = save.equipped === skin.id;

        const card = document.createElement("div");

        card.className =
            "skinCard" +
            (owned ? " owned" : "") +
            (equipped ? " equipped" : "");

        let action = "";

        if (equipped) {
            action = `
                <button class="btn secondary" disabled>
                    ✅ Équipé
                </button>
            `;
        } else if (owned) {
            action = `
                <button class="btn" onclick="equipSkin('${skin.id}')">
                    👕 Équiper
                </button>
            `;
        } else {
            action = `
                <button class="btn"
                        onclick="buySkin('${skin.id}')"
                        ${save.coins < skin.price ? "disabled" : ""}>
                    🪙 ${skin.price}
                </button>
            `;
        }

        card.innerHTML = `
            <div class="skinEmoji emoji">${skin.emoji}</div>
            <div class="skinName">${skin.name}</div>
            <div class="skinRarity">${skin.rarity}</div>
            <div class="skinPrice">
                ${owned ? "Possédé" : "🪙 " + skin.price}
            </div>
            ${action}
        `;

        grid.appendChild(card);
    });

    document.getElementById("shopCoins").textContent = save.coins;
}

function buySkin(id) {

    initAudio();

    const skin = getSkin(id);

    if (!skin || save.skins.includes(id)) return;

    if (save.coins < skin.price) {
        sfx("error");
        return;
    }

    save.coins -= skin.price;
    save.skins.push(id);

    saveGame();

    sfx("buy");

    renderShop();
    updateMenu();
}

function equipSkin(id) {

    initAudio();

